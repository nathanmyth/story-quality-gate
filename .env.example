# Copy to .env and fill in. Never commit .env.

# Jira Cloud (leave blank for dry-run mode)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Story
# Story points field ID differs per site (often customfield_10016). Leave blank to skip.
JIRA_STORY_POINTS_FIELD=

# Optional AI coach
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
